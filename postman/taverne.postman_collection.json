{
  "info": {
    "name": "API Taverne aux PNJ",
    "description": "Tests de l'API de la taverne. Lancer d'abord le serveur (npm run dev), remplir les variables email et motDePasse de la collection, puis lancer les requêtes dans l'ordre : la requête 2 enregistre le token, la requête 9 enregistre l'id du PNJ créé.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "" },
    { "key": "motDePasse", "value": "" },
    { "key": "token", "value": "" },
    { "key": "pnjId", "value": "" }
  ],
  "item": [
    {
      "name": "1. POST /api/connexion - Mauvais mot de passe (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"pas-le-bon-mot-de-passe\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/connexion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('Pas de token renvoyé', () => pm.expect(pm.response.json().token).to.be.undefined);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. POST /api/connexion - Connexion du MJ (200)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{motDePasse}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/connexion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Un token est renvoyé', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET /api/pnj - Liste des PNJ (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pnj"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('La réponse est un tableau de PNJ', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('Chaque PNJ a un nom, une classe et un niveau', () => {",
              "  pm.response.json().forEach(p => pm.expect(p).to.include.keys('id', 'nom', 'classe', 'niveau'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. GET /api/pnj?nom=gan - Recherche par nom (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pnj?nom=gan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Tous les noms contiennent \"gan\"', () => {",
              "  pm.response.json().forEach(p => pm.expect(p.nom.toLowerCase()).to.include('gan'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. GET /api/pnj/7 - Un PNJ (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pnj/7"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Le PNJ renvoyé a l\\'id 7', () => pm.expect(pm.response.json().id).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. GET /api/pnj/9999 - PNJ inexistant (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pnj/9999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. GET /api/pnj/abc - Id invalide (400)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pnj/abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. POST /api/pnj - Sans token (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Bilbo\",\n  \"classe\": \"Voleur\",\n  \"niveau\": 2\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/pnj"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 401 : le vigile bloque', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. POST /api/pnj - Création avec token (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Bilbo\",\n  \"classe\": \"Voleur\",\n  \"niveau\": 2\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/pnj"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Le PNJ créé a reçu un id', () => pm.expect(pm.response.json().pnj.id).to.be.a('number'));",
              "pm.collectionVariables.set('pnjId', pm.response.json().pnj.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. POST /api/pnj - Requête incomplète (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Bilbo\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/pnj"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. POST /api/pnj - JSON mal formé (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Bilbo\",\n",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/pnj"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Réponse au format JSON (pas une page HTML)', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "12. PUT /api/pnj/:id - Modifier le niveau (200)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"niveau\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/pnj/{{pnjId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Le niveau est passé à 5', () => pm.expect(pm.response.json().pnj.niveau).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. DELETE /api/pnj/:id - Supprimer (200)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/pnj/{{pnjId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. GET /api/inconnue - Route introuvable (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/inconnue"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Réponse au format JSON (pas une page HTML)', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    }
  ]
}
